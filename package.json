    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "image",
    "preview",
    "inline",
    "attachment",
    "screenshot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhb861832993-star/img-preview.git"
  },
  "homepage": "https://github.com/dhb861832993-star/img-preview#readme",
  "bugs": {
    "url": "https://github.com/dhb861832993-star/img-preview/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
